# ─────────────────────────────────────────────────────────────────────────────
# Pannaga Environment Configuration (.env.example)
# ─────────────────────────────────────────────────────────────────────────────

# Environment: 'development' | 'testing' | 'production'
ENV=development
DEBUG=true

# Public Base URL (Required for webhooks and CDN asset resolution)
PUBLIC_BASE_URL=http://localhost:8000

# ─── Database & Cache ────────────────────────────────────────────────────────
POSTGRES_USER=pannaga
POSTGRES_PASSWORD=pannaga
POSTGRES_DB=pannaga
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_URL=redis://redis:6379/0

# ─── Security & Authentication ───────────────────────────────────────────────
# In production, must be at least 32 cryptographically secure random bytes
SECRET_KEY=supersecretkey_for_development_only_please_change_in_production_minimum_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
DEV_OTP=000000
DEV_OTP_ENABLED=true

# ─── Messaging Gateway & Telecom Providers ──────────────────────────────────
# Provider selection: 'console' | 'mock' | 'twilio' | 'gupshup'
MESSAGING_PROVIDER=console

# Twilio Credentials (Used in production when MESSAGING_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Webhook Signatures
TWILIO_WEBHOOK_SECRET=mock_webhook_secret_key

# Telecom Regulatory & DLT Compliance (India)
DLT_ENTITY_ID=110145293000001
DLT_TEMPLATE_ID_SAFE_TO_SOW=1107161829300001
DLT_TEMPLATE_ID_DELAY_SOWING=1107161829300002
DLT_TEMPLATE_ID_ALTER_CROP=1107161829300003
DLT_TEMPLATE_ID_BREAK_ALERT=1107161829300004
DLT_TEMPLATE_ID_HEAVY_RAIN=1107161829300005

# ─── Speech & Translation (Bhashini AI) ──────────────────────────────────────
BHASHINI_API_KEY=mock_bhashini_api_key
BHASHINI_USER_ID=mock_bhashini_user_id
BHASHINI_PIPELINE_ID=mock_bhashini_pipeline_id
MEDIA_STORAGE_PATH=/app/media/audio

# ─── External Meteorological & Climate Feeds ────────────────────────────────
OPEN_METEO_BASE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
NOAA_ENSO_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
NOAA_MJO_URL=https://www.cpc.ncep.noaa.gov/products/precip/CWlink/daily_mjo_index/pentad/pentad.index.RMM.txt
BOM_IOD_URL=https://psl.noaa.gov/gcos_wgsp/Timeseries/Data/dmi.had.long.data
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0
CDS_API_KEY=mock_cds_api_key
CDS_URL=https://cds.climate.copernicus.eu/api/v2

# ─── Feature Flags & Safety Guards ──────────────────────────────────────────
ENABLE_IMERG=false
ENABLE_SHAP=false
ENABLE_REAL_MESSAGING=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Frontend Environment (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
