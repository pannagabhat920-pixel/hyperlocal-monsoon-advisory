    "/api/v1/officer/broadcast": {
      "post": {
        "tags": [
          "Officer"
        ],
        "summary": "Broadcast approved advisories to farmers",
        "description": "Dispatch approved advisories to all farmers in the relevant panchayats.\n\nSafety:\n  - confirm=False \u2192 dry-run, returns what would be sent\n  - SIMULATED advisories \u2192 BLOCKED_SIMULATED, never reach provider\n  - Only officers with jurisdiction over the advisory's block may broadcast\n  - Enforces farmer-level 72h cooldown (CRITICAL alerts bypass)\n  - Enforces farmer consent / opt-out",
        "operationId": "broadcast_advisories_api_v1_officer_broadcast_post",
        "requestBody": {
          "content": {
